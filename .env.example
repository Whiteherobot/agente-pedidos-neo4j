# Sin NEO4J_URI la API usa el catálogo en memoria.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cambiar-esta-clave

# Opcional: con clave, Gemini redacta las respuestas a partir de los datos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opcional: 1 para enrutar con embeddings (pip install sentence-transformers).
AGENTE_EMBEDDINGS=0
